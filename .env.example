# Create .env with: python scripts/init_env.py
# Add the real value ONLY in your local .env or hosting secret store.
# Never commit it. Restart the app after editing.
GEMINI_API_KEY=your-key-here
THREADGATE_MODEL=gemini-2.5-flash

# Shared timeout validation (milliseconds)
THREADGATE_HTTP_TIMEOUT_MS=30000
THREADGATE_TOTAL_BUDGET_MS=90000

# Local workspace; Docker Compose explicitly overrides this to /data/workspace.sqlite3
THREADGATE_WORKSPACE_DB=data/runs/workspace.sqlite3

# Optional public HTTPS deployment; set a real DNS hostname, no https:// prefix
THREADGATE_DOMAIN=your-domain.example

# Optional organisation policy: 1 restricts non-enrolled users to account/MFA setup
THREADGATE_REQUIRE_MFA=0
