# Copy to .env (local) or set as a Streamlit/Cloud secret (deployed).
# NEVER commit a real key. .env is in .gitignore.
GEMINI_API_KEY=your-key-here

# Optional overrides
THREADGATE_MODEL=gemini-2.5-flash
# offline   -> deterministic test double, no network (tests only)
# gemini    -> real model
# compromised -> adversarial harness: model always says "no change"
THREADGATE_EXTRACTOR=gemini
